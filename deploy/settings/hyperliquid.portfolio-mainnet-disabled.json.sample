{
    "settings": {
        "network": "mainnet",
        "sandbox_mode": false,
        "allow_mainnet": true,
        "perpetual": {
            "symbols": [
                "BTC/USDC:USDC",
                "ETH/USDC:USDC",
                "SOL/USDC:USDC",
                "XRP/USDC:USDC",
                "BNB/USDC:USDC",
                "DOGE/USDC:USDC"
            ],
            "signal_mode": "portfolio_trend_ensemble",
            "canary_mode": false,
            "entries_enabled": false,
            "entry_kill_switch_file": "/var/lib/crypto-spot-collector/ENTRY_KILL_SWITCH",
            "timeframe": "1d",
            "leverage": 1,
            "margin_mode": "cross",
            "take_profit_rate": 15.0,
            "stop_loss_rate": 3.0,
            "amountByUSDC": 12.5,
            "consecutivePositiveCount": 1,
            "price_change_threshold_percent": 999,
            "trailing_stop_interval_minutes": 15,
            "trailing_stop_activation_pnl_percent": 7.0,
            "sar_close_consecutive_count": 1,
            "portfolio": {
                "rebalance_tolerance_usdc": 10.0,
                "max_decision_delay_seconds": 21600
            },
            "risk": {
                "max_order_notional_usdc": 12.5,
                "max_symbol_notional_usdc": 75.0,
                "max_total_notional_usdc": 75.0,
                "max_positions": 6,
                "max_leverage": 1,
                "min_free_collateral_usdc": 25.0
            }
        }
    }
}
